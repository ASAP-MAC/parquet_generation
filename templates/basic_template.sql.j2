-- Usage: duckdb goose.duckdb < {{ outfile }}.sql
install httpfs;
load httpfs;
CREATE SECRET metagenomics_mac (
    TYPE gcs,
    KEY_ID '{{ key_id }}',
    SECRET '{{ secret }}'
);

PRAGMA temp_directory='{{ tmp_dir }}';
PRAGMA memory_limit='{{ mem_limit }}';

{% if sample_ids == '*' %}
-- Wildcard mode: read all matching files
SET VARIABLE test_prefixes = list_value('{{ base_prefix }}*');
{% else %}
SET VARIABLE sample_ids = list_value(
        {% for id in sample_ids %}
        '{{ id }}'{% if not loop.last %},{{ "\n" }}{% else %});{{ "\n" }}{% endif %}
        {% endfor %}
SET VARIABLE test_prefixes = list_transform(getvariable('sample_ids'), lambda x : concat('{{ base_prefix }}', x));
{% endif %}

-- Loop over data types:

{% for dt in data_types %}
-- {{ dt.description }}

SET VARIABLE {{ dt.table_name }}_columns =
    struct_pack(
        {% for name, dtype in dt.input_columns.items() %}
        {{ name }} := '{{ dtype }}'{% if not loop.last %},{{ "\n" }}{% else %}{{ "\n" }}{% endif %}
        {% endfor %}
    );

CREATE OR REPLACE TABLE {{ dt.table_name }} AS SELECT * FROM read_csv(
    list_transform(getvariable('test_prefixes'), lambda x : concat(x, '{{ dt.input_path_suffix }}')),
    filename=True,
    auto_detect=False,
    columns=getvariable('{{ dt.table_name }}_columns'),
    delim='\t',
    skip=0,
    store_rejects=True,
    rejects_scan='{{ dt.table_name }}_scan',
    rejects_table='{{ dt.table_name }}_errors');

CREATE OR REPLACE TABLE {{ dt.table_name }}_headers AS
WITH deduped_lines AS (
    SELECT DISTINCT scan_id, file_id, line, csv_line
    FROM {{ dt.table_name }}_errors
)
SELECT
    scan_id,
    file_id,
    string_agg(csv_line, '|' ORDER BY line) AS full_header,
    struct_pack(
        {% for name, index in dt.input_header.items() %}
        {{ name }} := split_part(full_header, '|', {{ index }}){% if not loop.last %},{{ "\n" }}{% else %}{{ "\n" }}{% endif %}
        {% endfor %}
    ) AS nested_header
FROM deduped_lines
GROUP BY scan_id, file_id;

CREATE OR REPLACE TABLE {{ dt.table_name }}_joined AS SELECT
    {% if dt.columns_to_split %}
    {% for colname, subcol in dt.columns_to_split.items() %}
    {% set delim = subcol.delimiter %}
    {% for name, index in subcol.parts.items() %}
    string_split_regex(t.{{ colname }}, '{{ delim }}')[{{ index }}] AS {{ name }},
    {% endfor %}
    {% endfor %}
    {% endif %}
    t.* EXCLUDE (t.filename),
    split_part(t.filename, '/', 6) AS uuid,
    UNNEST(h.nested_header)
FROM {{ dt.table_name }} AS t
INNER JOIN {{ dt.table_name }}_scan AS s ON t.filename = s.file_path
INNER JOIN {{ dt.table_name }}_headers AS h ON s.file_id = h.file_id;

{% if dt.columns_to_parse %}
{% if dt.columns_to_parse.values() | selectattr('regex') | list | length > 0 %}
UPDATE {{ dt.table_name }}_joined
SET
{% for name, attrs in dt.columns_to_parse.items() if 'regex' in attrs %}
    {{ name }} = regexp_extract({{ name }}, '{{ attrs.regex }}'){% if not loop.last %},{{ "\n" }}{% else %};{{ "\n\n" }}{% endif %}
{% endfor %}
{% endif %}
{% endif %}
{% if dt.columns_to_parse %}
{% for name, attrs in dt.columns_to_parse.items() if 'new_type' in attrs %}
ALTER TABLE {{ dt.table_name }}_joined ALTER COLUMN {{ name }} TYPE {{ attrs.new_type }};{% if not loop.last %}{% else %}{{ "\n\n" }}{% endif %}
{% endfor %}
{% endif %}
{% if dt.feature_hash %}
ALTER TABLE {{ dt.table_name }}_joined
ADD
    {% for name, incols in dt.feature_hash.items() %}
    {{ name }} VARCHAR{{ ',' if not loop.last else ';' }}
    {% endfor %}

UPDATE {{ dt.table_name }}_joined
SET
    {% for name, incols in dt.feature_hash.items() %}
    {{ name }} = md5(concat(
        {% for col in incols %}
        {{ col }}{% if not loop.last %},{{ "\n" }}{% else %})){% endif %}
        {% endfor %}{% if not loop.last %},{{ "\n" }}{% else %};{% endif %}
    {% endfor %}
{% endif %}


CREATE OR REPLACE TABLE {{ dt.table_name }}_samples AS SELECT DISTINCT
    {% for colname in dt.sample_columns %}
    {{ colname }}{% if not loop.last %},{{ "\n" }}{% else %}{{ "\n" }}{% endif %}
    {% endfor %}
FROM {{ dt.table_name }}_joined
ORDER BY {{ dt.sample_sort }};

CREATE OR REPLACE TABLE {{ dt.table_name }}_features AS SELECT DISTINCT
    {% for colname in dt.feature_columns %}
    {{ colname }}{% if not loop.last %},{{ "\n" }}{% else %}{{ "\n" }}{% endif %}
    {% endfor %}
FROM {{ dt.table_name }}_joined
ORDER BY {{ dt.feature_sort }};

CREATE OR REPLACE TABLE {{ dt.table_name }}_data AS SELECT
    {{ dt.sample_key }},
    {{ dt.feature_key }},
    {% for colname in dt.data_columns %}
    {{ colname }}{% if not loop.last %},{{ "\n" }}{% else %}{{ "\n" }}{% endif %}
    {% endfor %}
FROM {{ dt.table_name }}_joined;

COPY
    (SELECT * FROM {{ dt.table_name }}_data ORDER BY {{ dt.sample_key }} ASC)
TO '{{ outfile_prefix }}{{ dt.table_name }}_{{ dt.sample_key }}.parquet'
    (format parquet, compression 'zstd');

COPY
    (SELECT * FROM {{ dt.table_name }}_data ORDER BY {{ dt.feature_key }} ASC)
TO '{{ outfile_prefix }}{{ dt.table_name }}_{{ dt.feature_key }}.parquet'
    (format parquet, compression 'zstd');

COPY
    {% if ref_files_exist %}
    (SELECT * FROM {{ dt.table_name }}_samples
    UNION
    SELECT * FROM '{{ outfile_prefix }}{{ dt.table_name }}_sample_ref.parquet')
    {% else %}
    (SELECT * FROM {{ dt.table_name }}_samples)
    {% endif %}
TO '{{ outfile_prefix }}{{ dt.table_name }}_sample_ref.parquet'
    (format parquet, compression 'zstd');

COPY
    {% if ref_files_exist %}
    (SELECT * FROM {{ dt.table_name }}_features
    UNION
    SELECT * FROM '{{ outfile_prefix }}{{ dt.table_name }}_feature_ref.parquet')
    {% else %}
    (SELECT * FROM {{ dt.table_name }}_features)
    {% endif %}
TO '{{ outfile_prefix }}{{ dt.table_name }}_feature_ref.parquet'
    (format parquet, compression 'zstd');

DROP TABLE {{ dt.table_name }};
DROP TABLE {{ dt.table_name }}_scan;
DROP TABLE {{ dt.table_name }}_errors;
DROP TABLE {{ dt.table_name }}_headers;
DROP TABLE {{ dt.table_name }}_joined;
DROP TABLE {{ dt.table_name }}_data;
DROP TABLE {{ dt.table_name }}_samples;
DROP TABLE {{ dt.table_name }}_features;
{% endfor %}